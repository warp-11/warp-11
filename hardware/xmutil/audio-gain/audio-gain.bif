// bootgen input for converting audio_gain_bd_wrapper.bit (Vivado output)
// into audio_gain_bd_wrapper.bit.bin (FPGA-manager-loadable format used by
// xmutil/dfx-mgr on Zynq UltraScale+).
//
// Invoked indirectly via package_audio_gain.sh.

all:
{
  [destination_device = pl] audio_gain_bd_wrapper.bit
}
