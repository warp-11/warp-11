// bootgen input for converting audiobatch_bd_wrapper.bit (Vivado output) into
// audiobatch_bd_wrapper.bit.bin (FPGA-manager-loadable format used by xmutil/
// dfx-mgr on Zynq UltraScale+).
//
// Invoked indirectly via package_audio-batch.sh.

all:
{
  [destination_device = pl] audiobatch_bd_wrapper.bit
}
