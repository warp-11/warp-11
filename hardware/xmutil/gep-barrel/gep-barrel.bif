// bootgen input for converting gepbarrel_bd_wrapper.bit (Vivado output) into
// gepbarrel_bd_wrapper.bit.bin (FPGA-manager-loadable format used by xmutil/
// dfx-mgr on Zynq UltraScale+).
//
// Invoked indirectly via package_gepbarrel.sh.

all:
{
  [destination_device = pl] gepbarrel_bd_wrapper.bit
}
