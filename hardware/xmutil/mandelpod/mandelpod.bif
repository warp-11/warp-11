// bootgen input for converting mandelpod_bd_wrapper.bit (Vivado output) into
// mandelpod_bd_wrapper.bit.bin (FPGA-manager-loadable format used by xmutil/
// dfx-mgr on Zynq UltraScale+).
//
// Invoked indirectly via package_mandel.sh.

all:
{
  [destination_device = pl] mandelpod_bd_wrapper.bit
}
