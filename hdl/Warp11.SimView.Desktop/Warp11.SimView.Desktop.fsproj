<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Desktop.fs"/>
    </ItemGroup>


    <PropertyGroup>
        <PackageId>Warp11.SimView.Desktop</PackageId>
        <Description>Opens the Warp 11 step-through debugger as a desktop application: `Warp11.SimView.Desktop.debug "title" design` is the whole integration. Reference this from a desktop app; it brings Warp11.SimView and Warp11 with it.</Description>
        <PackageTags>fpga;hdl;fsharp;debugger;simulation;avalonia;waveform;vcd</PackageTags>
        <PackageReleaseNotes>Tracks Warp11 0.1.0-alpha.2. No change to this package's own API — it is still one function. Take all three packages at the same version.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../Warp11.SimView/README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11/Warp11.fsproj"/>
        <ProjectReference Include="../Warp11.SimView/Warp11.SimView.fsproj"/>
    </ItemGroup>

</Project>
