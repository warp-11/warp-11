<Project Sdk="Microsoft.NET.Sdk">

    <!-- The canvas spike's browser head: the same `Canvas.view` under a
         single-view lifetime on WebAssembly. Question three of the spike. -->
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
        <WarningsAsErrors>FS0025</WarningsAsErrors>
        <!-- Same reasoning as Warp11.Tutorial.Browser: the symbol map is fetched
             eagerly at boot and cannot be withheld at deploy time. -->
        <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
        <!-- Warp11.Placement is an executable (its checks); a self-contained wasm
             head may still reference its assembly — see aka.ms/netsdk1150. -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>

    <ItemGroup>
        <!-- Source-linked from the desktop spike: that project carries
             Avalonia.Desktop, whose native backends the wasm build cannot
             scan, so the view is compiled here rather than referenced. -->
        <Compile Include="../Warp11.Placement.Canvas/AudioSink.fs"/>
        <Compile Include="../Warp11.Placement.Canvas/Scope.fs"/>
        <Compile Include="../Warp11.Placement.Canvas/UnitSource.fs"/>
        <Compile Include="../Warp11.Placement.Canvas/FuncCanvas.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <WasmExtraFilesToDeploy Include="wwwroot/index.html"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Browser" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0"/>
        <PackageReference Include="Avalonia.FuncUI" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11.Placement/Warp11.Placement.fsproj"/>
    </ItemGroup>

</Project>
