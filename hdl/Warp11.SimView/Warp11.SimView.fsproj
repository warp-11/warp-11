<Project Sdk="Microsoft.NET.Sdk">

    <!-- A library, not an application. The debugger is a component a project
         customizes to fit itself — its own designs, its own panels — so the
         project owns `main` and this owns the window. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Theme.fs"/>
        <Compile Include="Controls.fs"/>
        <Compile Include="Waveform.fs"/>
        <Compile Include="Markdown.fs"/>
        <Compile Include="Highlight.fs"/>
        <Compile Include="View.fs"/>
        <Compile Include="Pages.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <!-- The F# grammar the source panel colours with. Embedded rather than
         copied beside the assembly: the browser tutorial is one bundle, and a
         loose file next to a wasm build is a file nobody fetches. -->
    <ItemGroup>
        <EmbeddedResource Include="Grammars/fsharp.tmLanguage.json"/>
    </ItemGroup>


    <PropertyGroup>
        <PackageId>Warp11.SimView</PackageId>
        <Description>The Warp 11 step-through debugger, as a component. Watch any signal at any hierarchy depth, poke inputs, page through memories, set breakpoints written as expressions over your own signal names, read a per-cycle waveform, export VCD. Platform-neutral (Avalonia + FuncUI) so the same debugger runs on the desktop and in a browser; reference Warp11.SimView.Desktop for a desktop application.</Description>
        <PackageTags>fpga;hdl;fsharp;debugger;simulation;avalonia;waveform;vcd</PackageTags>
        <PackageReleaseNotes>Tracks Warp11 0.1.0-alpha.3. New: `Pages.verilog`, a panel showing the Verilog the design on screen emits. Unlike `Pages.about` and `Pages.source` it takes no catalog, so an attached debugger can carry it — and both attach paths now do, which adds an Alongside column to a window that previously had none. `Catalog.embeddedFrom` takes several source files where `embedded` took one. IDebugSession and the snapshot types are fully documented, and those docs ship in the package.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0"/>
        <PackageReference Include="Avalonia.FuncUI" Version="2.0.0"/>
        <!-- The TextMate engine only. `TextMateSharp.Grammars` is the usual way
             to get the F# grammar and is 6.75 MB of the other 150. -->
        <PackageReference Include="TextMateSharp" Version="2.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11/Warp11.fsproj"/>
    </ItemGroup>

</Project>
