<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsAsErrors>FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Designs.fs"/>
        <Compile Include="Registry.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <!-- The cookbook pages and the catalog's own text, carried inside the
         assembly: the debugger shows both, and a published wasm bundle has no
         disk to read them off. `Designs.fs` is compiled *and* embedded — the
         source pane shows the same bytes the design was elaborated from. -->
    <ItemGroup>
        <EmbeddedResource Include="Designs.fs" LogicalName="Designs.fs"/>
        <EmbeddedResource Include="doc/*.md" LogicalName="doc/%(Filename).md"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11/Warp11.fsproj"/>
    </ItemGroup>

</Project>
