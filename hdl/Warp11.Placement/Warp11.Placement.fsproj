<Project Sdk="Microsoft.NET.Sdk">

    <!-- The placement use cases and the design model's checks. The model
         itself — `Fu`, `Graph`, `Edit`, `DesignFile`, `Elaborate`, `Export`,
         `Devices`, the palette — lives in the library since its promotion;
         `Placement.fs` is the use cases that judged the unit surface, and
         `GraphChecks.fs` the proof that data, typed and exported forms meet at
         the bytes. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsAsErrors>FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Placement.fs"/>
        <Compile Include="Examples.fs"/>
        <Compile Include="GraphChecks.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11.Design/Warp11.Design.fsproj"/>
    </ItemGroup>

</Project>
