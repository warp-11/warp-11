<Project Sdk="Microsoft.NET.Sdk">

    <!-- The canvas over a `Graph`, and the design running behind it. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsAsErrors>FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AudioSink.fs"/>
        <Compile Include="FuncCanvas.fs"/>
        <Compile Include="Patch.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0"/>
        <PackageReference Include="Avalonia.FuncUI" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11.Placement/Warp11.Placement.fsproj"/>
    </ItemGroup>

</Project>
