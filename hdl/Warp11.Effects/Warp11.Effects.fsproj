<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsAsErrors>FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Wrappers.fs"/>
        <Compile Include="Batch.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <!-- The debugger's source pane reads the design's own text out of the
         assembly, so the bytes shown are the bytes it was elaborated from. -->
    <ItemGroup>
        <EmbeddedResource Include="Batch.fs" LogicalName="Batch.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Warp11/Warp11.fsproj"/>
        <ProjectReference Include="../Warp11.SimView.Desktop/Warp11.SimView.Desktop.fsproj"/>
    </ItemGroup>

</Project>
